    "/api/v1/checkout": {
      "post": {
        "operationId": "CheckoutController_checkout",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "ticketTypeId",
                  "quantity",
                  "phoneNumber"
                ],
                "properties": {
                  "ticketTypeId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "quantity": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10
                  },
                  "phoneNumber": {
                    "type": "string",
                    "example": "254712345678"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Checkout initiated, STK Push sent.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "orderId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "paymentId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "checkoutSessionId": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "example": "PENDING"
                    },
                    "amount": {
                      "type": "string",
                      "example": "3000.0000"
                    },
                    "currency": {
                      "type": "string",
                      "example": "KES"
                    },
                    "expiresAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation failed (e.g., invalid phone format)."
          },
          "401": {
            "description": "Missing or invalid authentication token."
          },
          "409": {
            "description": "Insufficient ticket inventory."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Initiate a ticket purchase and M-Pesa STK Push",
        "tags": [
          "Commerce - Checkout"
        ]
      }
    },
    "/api/v1/media/search": {
      "get": {
        "operationId": "MediaController_search",
        "parameters": [
          {
