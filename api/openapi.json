              "type": "number"
            }
          },
          {
            "name": "type",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "ANIME",
                "MANGA"
              ],
              "type": "string"
            }
          },
          {
            "name": "q",
            "required": true,
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of matching media.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MediaListResponseDto"
                }
              }
            }
          }
        },
        "summary": "Search for anime or manga across the unified media layer",
        "tags": [
          "Content - Media"
        ]
      }
    },
