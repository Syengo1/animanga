  "info": {
    "title": "Animanga Platform API",
    "description": "Strictly defined contracts for Commerce, Events, and Identity",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "ScannerAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-scanner-api-key"
      }
    },
    "schemas": {
      "MediaTitleDto": {
        "type": "object",
        "properties": {
          "romaji": {
            "type": "string"
          },
          "english": {
            "type": "string"
          },
          "native": {
            "type": "string"
          }
        }
      },
      "MediaResponseDto": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string"
          },
          "externalId": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "ANIME",
              "MANGA"
            ]
          },
          "title": {
            "$ref": "#/components/schemas/MediaTitleDto"
          },
          "synopsis": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "season": {
            "type": "string",
            "nullable": true
          },
          "seasonYear": {
            "type": "number"
          },
          "coverImageUrl": {
            "type": "string"
          },
          "bannerImageUrl": {
            "type": "string"
          },
          "colorHex": {
            "type": "string"
          },
          "episodes": {
            "type": "number"
          },
          "chapters": {
            "type": "number"
          },
          "volumes": {
            "type": "number"
          },
          "genres": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "averageScore": {
            "type": "number"
          }
        },
        "required": [
          "provider",
          "externalId",
          "type",
          "title",
          "status",
          "genres"
        ]
      },
      "MediaListResponseDto": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MediaResponseDto"
            }
          }
        },
        "required": [
          "data"
        ]
      },
      "SingleMediaResponseDto": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/MediaResponseDto"
          }
        },
        "required": [
          "data"
        ]
      }
    }
  }
}